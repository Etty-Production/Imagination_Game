@{
	ViewData["Title"] = "Home Page";
}

<script src="~/js/signalr.min.js"></script>

<script>
    // Подключение к хабу
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/MouseControllerHub")
    .configureLogging(signalR.LogLevel.Information)
    .build();

    // Генерируем ID пользователя
    let userId = "User_" + Date.now();

    // --- ОТПРАВКА ДАННЫХ НА СЕРВЕР ---
    
    // Отправляем позицию мыши (с задержкой для производительности)
    let lastSendTime = 0;
    const sendInterval = 50; // мс (20 раз в секунду)

    connection.invoke("SendUserName", userId)
    .catch(err => console.error("Ошибка отправки позиции:", err));

    document.addEventListener("mousemove", function(e) {
    const now = Date.now();
    if (now - lastSendTime >= sendInterval) {
    lastSendTime = now;
    connection.invoke("SendMousePosition", userId, e.clientX, e.clientY)
    .catch(err => console.error("Ошибка отправки позиции:", err));
    }
    });

    // Отправляем события нажатия
    document.addEventListener("mousedown", function(e) {
    connection.invoke("SendMouseClick", userId, "mousedown", e.clientX, e.clientY)
    .catch(err => console.error("Ошибка отправки mousedown:", err));
    });

    document.addEventListener("mouseup", function(e) {
    connection.invoke("SendMouseClick", userId, "mouseup", e.clientX, e.clientY)
    .catch(err => console.error("Ошибка отправки mouseup:", err));
    });

    // --- ПОЛУЧЕНИЕ ДАННЫХ С СЕРВЕРА ---
    
    // Отображение позиции мыши других пользователей
    connection.on("ReceiveMousePosition", function(userId, x, y) {
    console.log(`👤 ${userId}: (${Math.round(x)}, ${Math.round(y)})`);
    updateCursor(userId, x, y);
    });

    connection.on("NewUserName", function(UserId) {
        userId = UserId;
    });

    // Отображение кликов других пользователей
    connection.on("ReceiveMouseClick", function(userId, action, x, y) {
    console.log(`🖱️ ${userId}: ${action} at (${Math.round(x)}, ${Math.round(y)})`);
    showClickEffect(userId, x, y, action);
    });

    // --- ВИЗУАЛИЗАЦИЯ ---
    
    // Создаем контейнер для курсоров
    const container = document.createElement('div');
    container.id = 'cursors-container';
    container.style.cssText = `
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99999;
    `;
    document.body.appendChild(container);

    function updateCursor(userId, x, y) {
    let cursor = document.getElementById(`cursor-${userId}`);
        
    if (!cursor) {
    cursor = document.createElement('div');
    cursor.id = `cursor-${userId}`;
    cursor.style.cssText = `
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid red;
    border-radius: 50%;
    background: rgba(255, 0, 0, 0.2);
    transform: translate(-50%, -50%);
    transition: all 0.05s linear;
    `;
    const label = document.createElement('div');
    label.textContent = userId;
    label.style.cssText = `
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: red;
    white-space: nowrap;
    font-family: Arial;
    `;
    cursor.appendChild(label);
    container.appendChild(cursor);
    }
        
    cursor.style.left = x + 'px';
    cursor.style.top = y + 'px';
    }

    function showClickEffect(userId, x, y, action) {
    const effect = document.createElement('div');
    effect.style.cssText = `
    position: absolute;
    left: ${x}px;
    top: ${y}px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 3px solid ${action === 'mousedown' ? '#00ff00' : '#ff0000'};
    transform: translate(-50%, -50%) scale(0);
    opacity: 1;
    pointer-events: none;
    transition: all 0.3s ease-out;
    `;
    container.appendChild(effect);
        
    // Анимация
    requestAnimationFrame(() => {
    effect.style.transform = 'translate(-50%, -50%) scale(1)';
    effect.style.opacity = '0';
    });
        
    setTimeout(() => effect.remove(), 300);
    }

    // --- ЗАПУСК ---
    
    connection.start()
    .then(() => {
    console.log(`✅ Подключено! Ваш ID: ${userId}`);
    console.log(`📊 Отправка позиции каждые ${sendInterval}мс`);
    })
    .catch(err => {
    console.error("❌ Ошибка подключения:", err);
    setTimeout(() => connection.start(), 5000);
    });

    // Переподключение при обрыве
    connection.onclose(() => {
    console.log("🔌 Соединение потеряно. Переподключение через 5 секунд...");
    setTimeout(() => connection.start(), 5000);
    });
</script>
